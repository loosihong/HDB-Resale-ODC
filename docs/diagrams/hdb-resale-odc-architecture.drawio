<mxfile host="app.diagrams.net"><diagram id="arch" name="Application architecture"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="1010" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="odc" value="&lt;b&gt;OutSystems Developer Cloud tenant&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Each app owns its entities, stored in ODC-managed PostgreSQL per stage&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fillColor=#FAFAF8;strokeColor=#888780;fontFamily=Helvetica;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="1240" height="730" as="geometry"/></mxCell><mxCell id="znet" value="&lt;b&gt;Internet-facing&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fillColor=#F3FAF7;strokeColor=#0F6E56;dashed=1;dashPattern=8 4;fontFamily=Helvetica;fontColor=#085041;" vertex="1" parent="1"><mxGeometry x="70" y="190" width="360" height="420" as="geometry"/></mxCell><mxCell id="zint" value="&lt;b&gt;Intranet&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fillColor=#F7F6FE;strokeColor=#534AB7;dashed=1;dashPattern=8 4;fontFamily=Helvetica;fontColor=#3C3489;" vertex="1" parent="1"><mxGeometry x="470" y="190" width="780" height="420" as="geometry"/></mxCell><mxCell id="zlib" value="&lt;b&gt;Libraries&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Strong dependencies, versioned and bundled into consumers&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fillColor=#F6F5F1;strokeColor=#888780;dashed=1;dashPattern=8 4;fontFamily=Helvetica;fontColor=#2C2C2A;" ver