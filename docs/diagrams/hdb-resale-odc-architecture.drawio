rokeColor=#534AB7;fontColor=#3C3489;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="510" y="480" width="280" height="70" as="geometry"/></mxCell><mxCell id="um" value="&lt;b&gt;User Management&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Native · users and authentication&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=13;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="910" y="480" width="300" height="70" as="geometry"/></mxCell><mxCell id="theme" value="&lt;b&gt;Theme Library&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Styles, layouts&lt;br&gt;Used by all 4 frontend apps&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=13;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="110" y="720" width="340" height="80" as="geometry"/></mxCell><mxCell id="common" value="&lt;b&gt;Common Library&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Helper actions, static entities&lt;br&gt;Used by all apps except User Management&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=13;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="490" y="720" width="340" height="80" as="geometry"/></mxCell><mxCell id="conn" value="&lt;b&gt;DataGovSg Connector&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Generic data.gov.sg REST middleware&lt;br&gt;Used by HDB Backend&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=13;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="870" y="720" width="340" height="80" as="geometry"/></mxCell><mxCell id="pu" value="Public users" style="ellipse;whit